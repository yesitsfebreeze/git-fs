/target/
/bin/
.DS_Store
*.log

# Local agent configuration, instructions, and session state
/.agents/
/install/codex/
/.claude/
/.claude-plugin/
/.codex/
/.codex-plugin/
/.machine/
/.git-fs/
/.mcp.json
/AGENTS.md
/AGENTS.override.md
/CLAUDE.md
/CLAUDE.local.md
/hooks/hooks.json

.overwatch/*
!.overwatch/vault/
.overwatch/vault/.obsidian/

# The overwatch Obsidian plugin keeps its runtime state (the server key, the lock, usage) in the vault; only its config, evidence and the hook record are shared.
docs/vault/.obsidian/plugins/overwatch
docs/vault/.overwatch/*
!docs/vault/.overwatch/config.json
!docs/vault/.overwatch/evidence/
!docs/vault/.overwatch/hooks.json
