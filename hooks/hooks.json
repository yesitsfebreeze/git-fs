{
	"hooks": {
		"SessionStart": [
			{ "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/git-fs hook session-start" }] }
		],
		"PreToolUse": [
			{ "matcher": "Read", "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/git-fs hook read" }] }
		],
		"PostToolUse": [
			{ "matcher": "Write|Edit|MultiEdit", "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/git-fs hook post-edit" }] }
		],
		"Stop": [
			{ "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/git-fs hook stop" }] }
		]
	}
}
